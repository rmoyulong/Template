#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- RT 实时内核（全内建版）
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
#
# 用法：先 make x86_64_defconfig，再用 merge_config.sh 叠加本文件，
#       最后 make olddefconfig 补全依赖。
#       6.12 起 PREEMPT_RT 已并入主线，无需打补丁。
#
# 模块策略（全内建 / monolithic）：
#   所有驱动一律 =y，全部编进 bzImage，部署只需一个 bzImage，
#   不依赖 /lib/modules 下任何 .ko（modules.tar.gz 只剩元数据，属正常）。
#
# 本文件已按 6.12.115 真实 Kconfig 逐符号校验：
# - 删除不存在符号：CONFIG_PREEMPT_RT_FULL（仅存在于 5.x 的 RT 补丁集）/
#   CONFIG_CIFS_STATS / CONFIG_CIFS_ACL / CONFIG_CIFS_MD5 /
#   CONFIG_CIFS_SHA2 / CONFIG_CIFS_HMAC_MD5 / CONFIG_CIFS_HMAC_SHA256
# - 排除隐藏符号（写了会被 olddefconfig 丢弃）：IRQ_FORCED_THREADING /
#   USB_COMMON / USB_XHCI_PCI / USB_EHCI_PCI / SND_HWDEP /
#   SND_SST_ATOM_HIFI2_PLATFORM / SND_AC97_CODEC / MT76_CORE /
#   CONFIG_HPET_TIMER（x86_64 下恒为 y 的 def_bool）
# - 修正 bool 误写为 =m 的符号（见下方注记）
# - 补全缺失前置依赖：NF_TABLES / SERIAL_DEV_BUS / MMC / STAGING /
#   I2C / X86_INTEL_LPSS / GPIOLIB / SPI_MASTER / MFD_ARIZONA / MFD_WM5102
#
# 本版新增（开机画面 / 启动体验修复）：
# - 显示：补 FB + FB_VESA，供传统 BIOS（GRUB 用 VBE 设的帧缓冲）兜底，
#   否则 MBR/传统 BIOS 启动没有 /dev/fb0，Plymouth 开机画面无法显示。
# - 拥塞控制：补 CONFIG_DEFAULT_BBR=y，否则 DEFAULT_TCP_CONG 会被
#   olddefconfig 按 choice 重新推导回 cubic，BBR 并不真正生效。
#
# 注意：本版 IWLWIFI=y（内建）。内建无线驱动会在内核启动早期就去加载固件，
#   而此时真正的 rootfs 还没挂载，固件只在 initramfs 里能被找到。
#   因此必须配合 build-rootfs.yml 里的 initramfs 固件 hook
#   （/etc/initramfs-tools/hooks/zz-firmware），把 iwlwifi/rtl 固件打进 initramfs，
#   否则会出现“找不到固件 → dump 满屏寄存器 → 冲掉 Plymouth 画面”。
#

# ---- 0. 模块支持（全内建也保留，便于生成 modules.builtin）----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt"
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y

# ---- 2. 电源管理（RT 下用 Performance，避免引入延迟）----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ---- 3. 显示 ----
# 重要：6.12 中 DRM_I915 带 "depends on !PREEMPT_RT"，RT 内核下必然为 n，
# 写 CONFIG_DRM_I915=y 会被 olddefconfig 丢弃。RT 下改用 simpledrm
# 提供控制台显示；如需 i915 必须改用非 RT 内核。
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# 传统 BIOS（GRUB 用 VBE 设置的帧缓冲）兜底：SYSFB_SIMPLEFB 能接管时走 simpledrm，
# 接管不了时由 vesafb 顶上；两个都没有的话，MBR/传统 BIOS 启动就没有帧缓冲，
# Plymouth 无法显示（RT 下 i915 又不可用）。
CONFIG_FB=y
CONFIG_FB_VESA=y

# ---- 4. 声卡（全部内建）----
# 4.1 核心
CONFIG_SND_PCI=y
CONFIG_SND_X86=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0
# 4.2 HDA 驱动与 codec
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_SI3054=y
CONFIG_SND_HDA_GENERIC=y
# 注：HDMI_LPE_AUDIO 依赖 DRM_I915，RT 内核下 i915 不可用，故本项无法启用，
# 已删除；RT 下 HDMI 音频走 HDA（SND_HDA_CODEC_HDMI）。
CONFIG_SND_ENS1371=y
CONFIG_SND_USB_AUDIO=y
# 4.3 Bay Trail / Haswell 板级音频（SoC 侧）
CONFIG_SND_SOC=y
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5651_MACH=y
CONFIG_SND_SOC_INTEL_CHT_BSW_RT5645_MACH=y
# WM5102 编解码（可选，Bay Trail 板罕见）；需 MFD_ARIZONA 与 SPI
CONFIG_SND_SOC_INTEL_BYTCR_WM5102_MACH=y
CONFIG_MFD_ARIZONA_I2C=y
CONFIG_MFD_WM5102=y
# Broadwell 音频（可选，J1900/J1800 用不到）
CONFIG_SND_SOC_INTEL_BROADWELL_MACH=y
CONFIG_SND_SOC_AC97_CODEC=y

# ---- 5. 有线网卡（全部内建）----
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_VIA_RHINE=y
CONFIG_8139TOO=y
CONFIG_8139CP=y
CONFIG_NE2K_PCI=y
CONFIG_TULIP=y
CONFIG_DE2104X=y

# ---- 6. 无线网卡（全部内建）----
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
CONFIG_ATH9K=y
CONFIG_ATH9K_HTC=y
CONFIG_ATH5K=y
CONFIG_CARL9170=y
CONFIG_ATH10K=y
CONFIG_B43=y
CONFIG_B43LEGACY=y
CONFIG_BRCMFMAC=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800PCI=y
CONFIG_RTL8187=y
CONFIG_RTL8192CU=y
CONFIG_RTL8192CE=y
CONFIG_RTL8192SE=y
CONFIG_RTL8192DE=y
CONFIG_RTL8XXXU=y
CONFIG_MT76x2E=y
CONFIG_MT76x0U=y
# RTL8723BS（staging SDIO WiFi）需要 MMC 与 STAGING
CONFIG_STAGING=y
CONFIG_MMC=y
CONFIG_RTL8723BS=y

# ---- 7. 蓝牙（全部内建；子特性为 bool，写 =y）----
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_ATH3K=y
CONFIG_BT_HCIUART_LL=y
CONFIG_BT_HCIBCM203X=y
CONFIG_BT_HCIBFUSB=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_MRVL=y
CONFIG_BT_MTKSDIO=y
CONFIG_CRYPTO_CMAC=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# ---- 8. 文件系统（根文件系统 EXT4 必须内建；FAT 内建以便读写 EFI 分区）----
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y

# ---- 9. 网络加速 / 拥塞控制 ----
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_TCP_CONG_BBR=y
# 必须同时选 DEFAULT_BBR=y：DEFAULT_TCP_CONG 是由 choice 推导的字符串，
# 只写 CONFIG_DEFAULT_TCP_CONG="bbr" 会被 olddefconfig 重新推导回 cubic。
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# ---- 10. Netfilter / NAT（需 NF_TABLES 主开关）----
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_TUNNEL=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_XFRM=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y

# ============================================================
# ========== 11. USB 主机控制器（键鼠/U盘必需，内建） ========
# ============================================================
# 说明：USB_COMMON / USB_XHCI_PCI / USB_EHCI_PCI / USB_OHCI_HCD_PCI 为隐藏项，
# 由以下可见项自动选中；全内建下必须保证可见项为 =y。
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ============================================================
# ========== 12. 输入设备核心 + HID（键盘鼠标必需） ==========
# ============================================================
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SENTELIC=y
CONFIG_MOUSE_PS2_TOUCHKIT=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y

# ============================================================
# ========== 13. 控制台 / TTY（保证 tty 可输入） ============
# ============================================================
# 说明：SERIO / SERIO_I8042 / SERIO_LIBPS2 由 KEYBOARD_ATKBD 自动 select。
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ============================================================
# ========== 14. Bay Trail 平台基础（SoC 音频/外设依赖） =====
# ============================================================
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_X86_INTEL_LPSS=y
CONFIG_GPIOLIB=y
# 注：SPI_MASTER 是隐藏项（default SPI），应写 CONFIG_SPI=y
CONFIG_SPI=y
# I2C_DESIGNWARE_PLATFORM 在 x86 上需要 COMMON_CLK
CONFIG_COMMON_CLK=y

# ---- 15. 其他工控机常用 ----
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- 16. CIFS/SMB File System（全内建）----
# 注：加密算法（CRYPTO_MD5/SHA256/SHA512/CMAC/HMAC/AES/ECB/CCM/GCM）
# 由 CONFIG_CIFS 自动 select，无需手写。
CONFIG_CIFS=y
CONFIG_CIFS_STATS2=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
