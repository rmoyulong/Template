#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- RT 实时内核（全内建版）
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
#
# 用法：
#   make x86_64_defconfig
#   scripts/kconfig/merge_config.sh -m .config <本文件>
#   make olddefconfig          # 自动补全依赖、剔除非法项
#   make -j$(nproc) bzImage modules
#
# 模块策略（全内建 / monolithic）：
#   所有驱动一律 =y，全部编进 bzImage —— 部署时只需一个 bzImage，
#   不依赖 /lib/modules 下任何 .ko；modules.tar.gz 里只剩元数据（约 90KB），
#   这是"全内建"的正常现象，不是错误、不是坏包。
#   代价：bzImage 较大（约 17~18MB）、编译略慢、换硬件需重编内核。
#
# ⚠️ 关键：defconfig 里 USB 控制器 / HID / PS2 键盘等基础驱动默认是 =m，
#    全内建模式下必须显式写成 =y，否则会出现"能启动、但键盘打字无反应"
#    （模块包是空的，等于驱动完全没开）。见第 11~13 节。
#
# 本文件已按 6.12.115 真实 Kconfig 逐项核对，三条硬规则：
#   ① 不写隐藏符号（无 prompt，写进去无效，由 select / default 决定）：
#      USB_COMMON、USB_XHCI_PCI、USB_EHCI_PCI、SND_HWDEP、
#      SND_SST_ATOM_HIFI2_PLATFORM、SND_AC97_CODEC、MT76_CORE、IRQ_FORCED_THREADING
#   ② bool 类型符号只能写 =y，不能写 =m（全内建版本来就全 =y）
#   ③ 6.12 不存在的符号一律删除：
#      CIFS_STATS、CIFS_ACL、CIFS_MD5、CIFS_SHA2、CIFS_HMAC_MD5、
#      CIFS_HMAC_SHA256、PREEMPT_RT_FULL（后两者是老 RT 补丁集遗留，主线不存在）
#

# ---- 0. 模块支持（全内建也保留，便于生成 modules.builtin）----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt"
# 建议保持关闭：否则在 git 仓库中构建会得到 6.12.115-rt-g<hash>，
# 使 /lib/modules/<ver> 路径漂移。
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
# 注意：PREEMPT_RT 是 6.12 唯一的实时开关；不要写 PREEMPT_RT_FULL（不存在）。
CONFIG_HZ_1000=y
# CONFIG_HZ 无独立 prompt，由上面的 choice（HZ_1000）决定，无需单独设置
CONFIG_HIGH_RES_TIMERS=y

# ---- 2. 电源管理（RT 下用 Performance 调度，避免引入延迟）----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ---- 3. 显示（Bay Trail 核显 i915，内建，避免早期控制台黑屏）----
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- 4. 声卡（全部内建）----
# 4.1 核心：缺这一支 /proc/asound 目录都不会出现，必须内建
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_X86=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0
# 4.2 HDA 驱动与 codec
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_SI3054=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_HDMI_LPE_AUDIO=y
CONFIG_SND_ENS1371=y
CONFIG_SND_USB_AUDIO=y
# 4.3 Bay Trail / Haswell 板级音频（SoC 侧）
CONFIG_SND_SOC=y
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5651_MACH=y
CONFIG_SND_SOC_INTEL_BYTCR_WM5102_MACH=y
CONFIG_SND_SOC_INTEL_CHT_BSW_RT5645_MACH=y
CONFIG_SND_SOC_INTEL_BROADWELL_MACH=y
CONFIG_SND_SOC_AC97_CODEC=y

# ---- 5. 有线网卡（全部内建）----
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_VIA_RHINE=y
CONFIG_8139TOO=y
CONFIG_8139CP=y
CONFIG_NE2K_PCI=y
CONFIG_TULIP=y
CONFIG_DE2104X=y

# ---- 6. 无线网卡（全部内建）----
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
CONFIG_ATH9K=y
CONFIG_ATH9K_HTC=y
CONFIG_ATH5K=y
CONFIG_CARL9170=y
CONFIG_ATH10K=y
CONFIG_B43=y
CONFIG_B43LEGACY=y
CONFIG_BRCMFMAC=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800PCI=y
CONFIG_RTL8187=y
CONFIG_RTL8192CU=y
CONFIG_RTL8192CE=y
CONFIG_RTL8192SE=y
CONFIG_RTL8192DE=y
CONFIG_RTL8723BS=y
CONFIG_RTL8XXXU=y
CONFIG_MT76x2E=y
CONFIG_MT76x0U=y

# ---- 7. 蓝牙（全部内建）----
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_ATH3K=y
CONFIG_BT_HCIUART_LL=y
CONFIG_BT_HCIBCM203X=y
CONFIG_BT_HCIBFUSB=y
CONFIG_BT_HCIVHCI=y
CONFIG_BT_MRVL=y
CONFIG_BT_MTKSDIO=y
CONFIG_CRYPTO_CMAC=y

# ---- 8. 文件系统（根文件系统 EXT4 必须内建；FAT 内建以便读写 EFI 分区）----
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y

# ---- 9. 网络加速 / 拥塞控制（内核核心）----
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_TCP_CONG 无独立 prompt，由 CONFIG_DEFAULT_BBR 自动得出（bbr）

# ---- 10. Netfilter / NAT（常用转发/容器场景）----
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_CT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_TUNNEL=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_XFRM=y
CONFIG_NETFILTER_XTABLES=y

# ============================================================
# ==========  11. USB 主机控制器（键鼠/U盘必需，内建）  ========
# ============================================================
# ⚠️ defconfig 里这些默认是 =m。全内建模式下若不改成 =y，
#    bzImage 里没有 USB 控制器驱动，而模块包又是空的（全内建不产 .ko）
#    → 插上的 USB 键盘/鼠标完全不工作。这就是"能启动但不能打字"的根因。
CONFIG_USB=y
CONFIG_USB_PCI=y
# USB 3.0（Bay Trail 主要 USB 口）
CONFIG_USB_XHCI_HCD=y
# USB 2.0
CONFIG_USB_EHCI_HCD=y
# USB 1.1
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
# 老式 UHCI 控制器
CONFIG_USB_UHCI_HCD=y
# U 盘 / 外接存储（排查问题必备）
CONFIG_USB_STORAGE=y
# USB_STORAGE 的硬依赖：必须同时内建 SCSI 与 SCSI 磁盘
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ============================================================
# ==========  12. 输入设备核心 + HID（键盘鼠标必需）  ==========
# ============================================================
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
# AT/PS2 键盘（所有键盘的基础驱动）
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
# PS/2 鼠标
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SENTELIC=y
CONFIG_MOUSE_PS2_TOUCHKIT=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_INPUT_MOUSEDEV=y
# 串行输入核心 + i8042 控制器（PS/2 键盘经此；被 USB 键盘链路间接依赖）
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
# 通用 HID（USB 键盘的核心协议驱动）
CONFIG_HID=y
CONFIG_HID_GENERIC=y
# USB HID 传输层（没有它 USB 键盘完全不工作）
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_INPUT_EVDEV=y

# ============================================================
# ==========  13. 控制台 / TTY（保证 tty 可输入、可回显）  =====
# ============================================================
CONFIG_TTY=y
CONFIG_VT=y
# VT 控制台（必须，否则 tty 打字无反应）
CONFIG_VT_CONSOLE=y
# 控制台字符翻译（键盘输入字符正确显示）
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- 14. 其他工控机常用 ----
CONFIG_HPET_TIMER=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ============================================================
# ==========  15. CIFS/SMB File System Support（全内建）  =====
# ============================================================
# 全内建模式下，文件系统驱动必须 =y，直接编入 bzImage，
# 不需要也不应该生成 cifs.ko 模块（否则启动后 mount 会报
# "cifs filesystem not supported / No such device"）。
# 旧写法 CONFIG_CIFS=m 与"全内建"自相矛盾，已修正为 =y。
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
CONFIG_CIFS_UPCALL=y
CONFIG_CIFS_DFS_UPCALL=y
# 说明：CIFS 的 Kconfig 会自动 select 一整套加密依赖
#   （CRYPTO_MD5 / SHA256 / SHA512 / CMAC / HMAC / AES / ECB / GCM / CCM / AEAD2），
# 无需手工添加；不要写 CIFS_MD5 / CIFS_SHA2 / CIFS_HMAC_* / CIFS_ACL / CIFS_STATS
# 这些在 6.12.115 中并不存在的符号。
