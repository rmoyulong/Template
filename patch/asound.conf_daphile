defaults.pcm.rate_converter "samplerate_best"

pcm.!default {
	type plug
	slave.pcm "softvol"
}

pcm.softvol {
	type softvol
	slave {
		pcm "dmixer"
	}
	control {
		name "Master"
		card "Loopback"
	}
}

pcm.dmixer  {
	type dmix
	ipc_key 1024
	ipc_key_add_uid false
	ipc_perm 0666
		slave {
			pcm "card"
			period_time 0
			period_size 1024
			buffer_size 4096
			rate 48000
			channels 2
		}
		bindings {
			0 0
			1 1
		}
}

pcm.card {
	type hw
	card "Loopback"
	device 0
	subdevice 0
}