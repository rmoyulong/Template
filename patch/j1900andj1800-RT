# ---- 7. 蓝牙 ----
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
