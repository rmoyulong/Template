#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- RT 实时内核（全内建版）
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
#
# 用法：先 make x86_64_defconfig，再用 merge_config.sh 叠加本文件。
#       仅写"需要在 defconfig 基础上额外开启或修改"的选项；
#       NET/INET/PCI/USB/EXT4/EFI/DEVTMPFS/CGROUPS 等基础项由 defconfig 提供。
#       6.12 起 PREEMPT_RT 已并入主线，无需打补丁。
#
# 模块策略（本文件 = 全内建 / monolithic）：
#   所有驱动一律 =y，全部编进 bzImage —— 部署时只需一个 bzImage 文件，
#   不依赖 /lib/modules 下任何 .ko；modules.tar.gz 里只剩元数据（约 90KB），
#   这是"全内建"的正常现象，不是错误、不是坏包。
#   代价：bzImage 较大（约 17~18MB）、编译略慢、换硬件需重编内核。
#   注意：固件（firmware）不会编进内核，仍要靠 rootfs 里的 /lib/firmware
#         （firmware-realtek / firmware-iwlwifi / firmware-linux 等）。
#   需要"bzImage 小、驱动走模块"时：把下面驱动行的 =y 改回 =m 即可。
#

# ---- 0. 模块支持（全内建也建议保留，便于日后切换/生成 modules.builtin）----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt"
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IRQ_FORCED_THREADING=y

# 注：CONFIG_PREEMPT 在 defconfig 里是 =y（x86 默认），不必重复。
#     CONFIG_PREEMPT_DYNAMIC 与 PREEMPT_RT 互斥，不写。

# ---- 2. 电源管理（RT 下用 Performance 调度，避免引入延迟）----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ---- 3. 显示（Bay Trail 核显 i915，内建，避免早期控制台黑屏）----
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- 4. 声卡（全部内建）----
