#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- RT 实时内核（全内建版）
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
# 实际硬件：RTL8111 有线网卡 + Intel 6205 无线网卡（其余网卡、蓝牙本机都不存在）
#
# 用法：先 make x86_64_defconfig，再用 merge_config.sh 叠加本文件，
#       最后 make olddefconfig 补全依赖。
#       6.12 起 PREEMPT_RT 已并入主线，无需打补丁。
#
# 模块策略（全内建 / monolithic）：
#   所有驱动一律 =y，全部编进 bzImage，部署只需一个 bzImage，
#   不依赖 /lib/modules 下任何 .ko（modules.tar.gz 只剩元数据，属正常）。
#
# 本文件已按 6.12.115 真实 Kconfig 逐符号校验：
# - 删除不存在符号：CONFIG_PREEMPT_RT_FULL（仅存在于 5.x 的 RT 补丁集）/
#   CONFIG_CIFS_STATS / CONFIG_CIFS_ACL / CONFIG_CIFS_MD5 /
#   CONFIG_CIFS_SHA2 / CONFIG_CIFS_HMAC_MD5 / CONFIG_CIFS_HMAC_SHA256
# - 排除隐藏符号（写了会被 olddefconfig 丢弃）：IRQ_FORCED_THREADING /
#   USB_COMMON / USB_XHCI_PCI / USB_EHCI_PCI / SND_HWDEP /
#   SND_SST_ATOM_HIFI2_PLATFORM / SND_AC97_CODEC / MT76_CORE /
#   CONFIG_HPET_TIMER（x86_64 下恒为 y 的 def_bool）
#
# 【本版重要变更 —— 瘦身提速】
#   x86_64_defconfig 是"通用 x86_64"配置，自带一大批 Bay Trail 用不到的
#   驱动和子系统。这些内建项会在开机时逐个去探测并不存在的硬件（白白耗时），
#   同时把 bzImage 撑大。本版按"本机实际存在的硬件"做了裁剪，详见文件末尾
#   【C. 精简】一节。
#   裁剪原则：只关本机没有的硬件；启动链路（SATA/USB/键鼠/显示/板载网卡/
#   根文件系统）一律保持内建，绝对不会出现"改完起不来"。
#
# 保留的重要特性：
# - 显示：FB + FB_VESA + DRM_SIMPLEDRM + SYSFB_SIMPLEFB，MBR/传统 BIOS 与
#   UEFI 两条路都有帧缓冲，Plymouth 开机画面可显示（RT 下 i915 不可用）。
# - 拥塞控制：CONFIG_DEFAULT_BBR=y，否则 olddefconfig 会按 choice 退回 cubic。
# - 内核压缩：zstd（解压速度约为 gzip 的 2~3 倍，开机更快；构建机需装 zstd）。
# - CIFS/SMB：保留，便于访问 NAS 共享。
# - 外设：品牌专用 HID 驱动（罗技 / 微软 / 双飞燕 / 樱桃 / 红龙 / 苹果）已内建，
#   罗技无线（Unifying 接收器）依赖 HID_LOGITECH_DJ，已一并开启（见 11.1 节）。
#
# 注意：本版 IWLWIFI=y（内建）。内建无线驱动会在内核启动早期就去加载固件，
#   而此时真正的 rootfs 还没挂载，固件只可能在 initramfs 里被找到。
#   因此必须配合 build-rootfs.yml 里的 initramfs 固件 hook
#   （/etc/initramfs-tools/hooks/zz-firmware），把 iwlwifi / rtl_nic 固件打进
#   initramfs，否则会出现"找不到固件 → dump 满屏寄存器 → 冲掉 Plymouth 画面"。
#

# ---- 0. 模块支持（全内建也保留，便于生成 modules.builtin）----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt"
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y

# ---- 1b. 内核镜像压缩算法（方案一：zstd，解压最快）----
# 6.12 的内核压缩算法是 choice 组，默认 KERNEL_GZIP；必须显式关掉 GZIP，
# 否则 merge_config 后会同时出现两个 choice 成员，olddefconfig 会退回默认 gzip。
# 注意：KERNEL_ZSTD 需要构建机具备 zstd 命令（build-kernel.yml 已加入）。
# CONFIG_KERNEL_GZIP is not set
CONFIG_KERNEL_ZSTD=y

# ---- 2. 电源管理（RT 下用 Performance，避免引入延迟）----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ---- 3. 显示 ----
# 重要：6.12 中 DRM_I915 带 "depends on !PREEMPT_RT"，RT 内核下必然为 n，
# 写 CONFIG_DRM_I915=y 会被 olddefconfig 丢弃。RT 下改用 simpledrm
# 提供控制台显示；如需 i915 必须改用非 RT 内核。
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# 传统 BIOS（GRUB 用 VBE 设置的帧缓冲）兜底：SYSFB_SIMPLEFB 能接管时走
# simpledrm，接管不了时由 vesafb 顶上；两个都没有的话，MBR/传统 BIOS 启动
# 就没有帧缓冲，Plymouth 无法显示。
CONFIG_FB=y
CONFIG_FB_VESA=y

# ---- 4. 声卡（本机走 HDA + Realtek）----
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_X86=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0
# Bay Trail / Cherry Trail 板级音频（SoC 侧，作为 HDA 之外的补充）
# 注：HDMI_LPE_AUDIO 依赖 DRM_I915，RT 内核下 i915 不可用，故无法启用；
#     RT 下 HDMI 音频走 HDA（SND_HDA_CODEC_HDMI）。
CONFIG_SND_SOC=y
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5651_MACH=y
CONFIG_SND_SOC_INTEL_CHT_BSW_RT5645_MACH=y

# ---- 5. 有线网卡（本机只有 RTL8111，走 r8169）----
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y

# ---- 6. 无线网卡（本机只有 Intel 6205，走 iwlwifi）----
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y

# ---- 7. 文件系统（根 EXT4 必须内建；FAT 内建以便读写 EFI 分区）----
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- 8. 网络加速 / 拥塞控制 ----
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_TCP_CONG_BBR=y
# 必须同时选 DEFAULT_BBR=y：DEFAULT_TCP_CONG 是由 choice 推导的字符串，
# 只写 CONFIG_DEFAULT_TCP_CONG="bbr" 会被 olddefconfig 重新推导回 cubic。
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# ---- 9. Netfilter / NAT（需 NF_TABLES 主开关）----
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_TUNNEL=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_XFRM=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y

# ============================================================
# ========== 10. USB 主机控制器（键鼠/U盘必需，内建） ========
# ============================================================
# 说明：USB_COMMON / USB_XHCI_PCI / USB_EHCI_PCI / USB_OHCI_HCD_PCI 为隐藏项，
# 由以下可见项自动选中；全内建下必须保证可见项为 =y。
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ============================================================
# ========== 11. 输入设备核心 + HID（键盘鼠标必需） ==========
# ============================================================
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SENTELIC=y
CONFIG_MOUSE_PS2_TOUCHKIT=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y

# ---- 11.1 品牌专用 HID 驱动（家里常见的有线 / 无线键鼠）----
# 说明：让罗技 / 微软等品牌的外设完整功能生效；不装也能用（走 HID_GENERIC），
#   但罗技无线（Unifying 接收器）会被拆成"一个鼠标 + 一个键盘"的合体设备。
# 注意：HID_LOGITECH 依赖 LEDS_CLASS，而 LEDS_CLASS 定义在 `if NEW_LEDS` 内部，
#   所以 NEW_LEDS 必须一起打开，否则下面几行会被静默忽略（写了等于没写）。
#   HID_LOGITECH_DJ = 无线接收器支持；HID_LOGITECH_HIDPP 已由它自动 select。
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_A4TECH=y
CONFIG_HID_CHERRY=y
CONFIG_HID_REDRAGON=y
CONFIG_HID_APPLE=y

# ============================================================
# ========== 12. 控制台 / TTY（保证 tty 可输入） ============
# ============================================================
# 说明：SERIO / SERIO_I8042 / SERIO_LIBPS2 由 KEYBOARD_ATKBD 自动 select。
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ============================================================
# ========== 13. Bay Trail 平台基础（SoC 音频/外设依赖） =====
# ============================================================
CONFIG_I2C=y
# 说明：CONFIG_I2C_DESIGNWARE_PLATFORM 在你两次真实构建产出的 .config 里
#   都不存在 —— 它的依赖 (ACPI && COMMON_CLK) 在当前配置下未满足，写了不会生效。
#   即 Bay Trail 的 DesignWare I2C 控制器驱动在当前配置下无法启用。
# CONFIG_I2C_DESIGNWARE_PLATFORM is not set
CONFIG_X86_INTEL_LPSS=y
CONFIG_GPIOLIB=y
# 注：SPI_MASTER 是隐藏项（default SPI），应写 CONFIG_SPI=y
CONFIG_SPI=y
# I2C_DESIGNWARE_PLATFORM 在 x86 上需要 COMMON_CLK
CONFIG_COMMON_CLK=y

# ============================================================
# ========== 14. SD 卡（部分工控板带 SD 槽；用不到可关） ====
# ============================================================
CONFIG_MMC=y

# ---- 15. 其他工控机常用 ----
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- 16. CIFS/SMB File System（全内建）----
# 注：加密算法（CRYPTO_MD5/SHA256/SHA512/CMAC/HMAC/AES/ECB/CCM/GCM）
# 由 CONFIG_CIFS 自动 select，无需手写。
CONFIG_CIFS=y
CONFIG_CIFS_STATS2=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y

# ============================================================
# ========== C. 精简：关闭本机用不到的子系统 ==================
# ============================================================
# 为什么放在最后：merge_config.sh 按顺序合并，后面的行覆盖前面的，
#   所以"关闭"一律写在这里，保证能压过前面任何 =y / =m 的写法。
#
# 判定依据：已用 build-kernel 产出的最终 .config（config-rt.txt）逐符号核对，
#   下面每一项在该配置里当前都是 =y（即真实占用 bzImage 空间），确认后才关。
#
# ★ 安全边界：以下内容完全不涉及启动链路 —— SATA/AHCI、USB 控制器与存储、
#   HID/键盘、VT 控制台、显示帧缓冲、RTL8111 网卡、Intel 无线、ext4/vfat
#   全部原样保留。若某项未列在这里，就是刻意保留的。

# ---- C1. 虚拟化 / 云主机支持（物理机完全用不到）----
# HYPERVISOR_GUEST 关掉后，KVM_GUEST / PARAVIRT 等会随之自动关闭。
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set

# ---- C2. 无关有线网卡（本机只有 RTL8111，见上面第 5 节）----
# CONFIG_E1000 is not set
# CONFIG_E1000E is not set
# CONFIG_IGB is not set
# CONFIG_IGC is not set
# CONFIG_8139TOO is not set
# CONFIG_8139CP is not set
# CONFIG_NE2K_PCI is not set
# CONFIG_TULIP is not set
# CONFIG_DE2104X is not set
# CONFIG_VIA_RHINE is not set

# ---- C3. 无关无线网卡（本机只有 Intel 6205，见上面第 6 节）----
# 关掉厂商总开关即可连带关掉其下所有驱动（ATH* / B43* / RT2X00 /
# RTL8187 / RTL8192* / RTL8XXXU / RTL8723BS / MT76* 等）。
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
#
# 想恢复某家的网卡（例如换成 Atheros 网卡），把对应那行整行删掉即可。

# ---- C4. 蓝牙（本机无蓝牙）----
# 关掉主开关，整条蓝牙栈（USB/UART/SDIO 三路）全部不编。
# CONFIG_BT is not set

# ---- C5. 调试 / 追踪（生产机不需要，与功能无关）----
# KALLSYMS_ALL 是收益最大的一项：它把内核里所有符号（含局部符号）都存进
# bzImage 的符号表里，纯属排障用。
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_BLK_DEV_IO_TRACE is not set

# ---- C6. 冗余文件系统（根用 ext4，EFI 用 vfat，已经够了）----
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_9P_FS is not set
# 下面两项按需保留（默认关闭）。若以后要挂 ISO 镜像 / 挂 NFS 共享，
# 把对应那行整行删掉（或改成 CONFIG_XXX=y）即可启用。
# CONFIG_ISO9660_FS is not set
# CONFIG_NFS_FS is not set

# ---- C7. 冗余块设备 / SCSI / 老式 PATA ----
# 注：BLK_DEV_MD（软 RAID）与 BLK_DEV_DM（LVM / dm-crypt）刻意保留，
