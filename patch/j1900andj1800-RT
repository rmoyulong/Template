CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
CONFIG_ATH9K=y
CONFIG_ATH9K_HTC=y
CONFIG_ATH5K=y
CONFIG_CARL9170=y
CONFIG_ATH10K=y
CONFIG_B43=y
CONFIG_B43LEGACY=y
CONFIG_BRCMFMAC=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800PCI=y
