#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- RT 实时内核
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
#
# 用法：先 make x86_64_defconfig，再用 merge_config.sh 叠加本文件。
#       仅写"需要在 defconfig 基础上额外开启或修改"的选项，
#       基础选项（NET/INET/PCI/USB/EXT4/EFI/FUSE 等）让 defconfig 自己处理。
#       6.12 起 PREEMPT_RT 已并入主线，无需打补丁。
#

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt"
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IRQ_FORCED_THREADING=y

# 注：CONFIG_PREEMPT 在 defconfig 里是 =y（x86 默认），不必重复。
#     CONFIG_PREEMPT_DYNAMIC 与 PREEMPT_RT 互斥，不写。

# ---- 2. 电源管理（RT 下用 Performance 调度，避免引入延迟）----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ---- 3. 显示（Bay Trail 核显 i915，defconfig 默认已是 =m，这里确保内建）----
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- 4. 声卡（核心！缺这条 /proc/asound 都不会出现）----
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_SI3054=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0
CONFIG_SND_X86=y
CONFIG_HDMI_LPE_AUDIO=y
CONFIG_SND_ENS1371=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_HWDEP=y
CONFIG_SND_SEQUENCER=y

# Bay Trail/Haswell 板级音频（SoC 侧）
CONFIG_SND_SOC=y
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5651_MACH=y
CONFIG_SND_SOC_INTEL_BYTCR_WM5102_MACH=y
CONFIG_SND_SOC_INTEL_CHT_BSW_RT5645_MACH=y
CONFIG_SND_SOC_INTEL_BROADWELL_MACH=y
CONFIG_SND_AC97_CODEC=y
CONFIG_SND_SOC_AC97_CODEC=y

# ---- 5. 有线网卡（覆盖常见型号）----
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_VIA_RHINE=y
CONFIG_8139TOO=y
CONFIG_8139CP=y
CONFIG_NE2K_PCI=y
CONFIG_TULIP=y
CONFIG_DE2104X=y

# ---- 6. 无线网卡 ----
