#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- RT 实时内核（模块化版）
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
#
# 用法：先 make x86_64_defconfig，再用 merge_config.sh 叠加本文件，
#       最后 make olddefconfig 补全依赖。
#       6.12 起 PREEMPT_RT 已并入主线，无需打补丁。
#
# 模块策略（混合模式：关键驱动内建 + 其余模块化）：
#   =y：根文件系统、显示、USB 控制器/存储、HID/键盘鼠标、控制台、板载主网卡、
#       Bay Trail 平台基础（I2C/GPIO/LPSS）
#   =m：声卡、无线网卡、蓝牙、额外有线网卡、额外文件系统、Netfilter
#
# 本文件已按 6.12.115 真实 Kconfig 逐符号校验：
#   - 删除不存在符号：CONFIG_CIFS_STATS / CONFIG_CIFS_ACL /
#     CONFIG_CIFS_MD5 / CONFIG_CIFS_SHA2 / CONFIG_CIFS_HMAC_MD5 / CONFIG_CIFS_HMAC_SHA256
#   - 修正 bool 误写为 =m 的符号（SND_PCI / SND_X86 / NF_TABLES_INET /
#     BT_HCIBTUSB_BCM / BT_HCIBTUSB_RTL / BT_HCIBTUSB_MTK /
#     BT_HCIUART_BCM / BT_HCIUART_RTL / BT_HCIUART_ATH3K / BT_HCIUART_LL）
#   - 排除隐藏符号（无 prompt，写了也会被 olddefconfig 丢弃）：
#     IRQ_FORCED_THREADING / USB_COMMON / USB_XHCI_PCI / USB_EHCI_PCI /
#     SND_HWDEP / SND_SST_ATOM_HIFI2_PLATFORM / SND_AC97_CODEC / MT76_CORE
#   - 补全缺失前置依赖：NF_TABLES / SERIAL_DEV_BUS / MMC / STAGING /
#     I2C / X86_INTEL_LPSS / GPIOLIB / SPI_MASTER / MFD_ARIZONA / MFD_WM5102
#

# ---- 0. 模块支持 ----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt-mod"
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y

# ---- 2. 电源管理（RT 下用 Performance，避免引入延迟）----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ============================================================
# ==========  A. 关键驱动 —— 内建（=y）  ======================
# ============================================================

# ---- 3. 显示 ----
# 重要：6.12 中 DRM_I915 带 "depends on !PREEMPT_RT"，RT 内核下必然为 n，
#       写 CONFIG_DRM_I915=y 会被 olddefconfig 丢弃。RT 下改用 simpledrm
#       提供控制台显示；如需 i915 必须改用非 RT 内核。
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- 4. USB 主机控制器（键鼠/U盘必需，内建）----
# 说明：USB_COMMON、USB_XHCI_PCI、USB_EHCI_PCI、USB_OHCI_HCD_PCI 为隐藏项，
#       由下面这些可见项自动选中，无需（也不能）手写。
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
# U 盘/外接存储（依赖 SCSI 与 BLK_DEV_SD）
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ---- 5. 输入设备核心 + HID（键盘鼠标必需，内建）----
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SENTELIC=y
CONFIG_MOUSE_PS2_TOUCHKIT=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y

# ---- 6. 控制台 / TTY ----
# 说明：SERIO / SERIO_I8042 / SERIO_LIBPS2 由 KEYBOARD_ATKBD 自动 select。
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- 7. 板载主网卡（RTL8111，内建保证一定有网）----
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y

# ---- 8. 文件系统（根 FS 与 EFI 分区必需，内建）----
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- 9. Bay Trail 平台基础（SoC 音频/外设的内建依赖）----
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_X86_INTEL_LPSS=y
CONFIG_GPIOLIB=y
# 注：SPI_MASTER 是隐藏项（default SPI），应写 CONFIG_SPI=y
CONFIG_SPI=y
# I2C_DESIGNWARE_PLATFORM 在 x86 上需要 COMMON_CLK
CONFIG_COMMON_CLK=y

# ============================================================
# ==========  B. 其余驱动 —— 模块化（=m）  ====================
# ============================================================

# ---- 10. 声卡（模块化）----
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_PCI=y
CONFIG_SND_X86=y
CONFIG_SND_SEQUENCER=m
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_CA0132=m
CONFIG_SND_HDA_CODEC_SI3054=m
CONFIG_SND_HDA_GENERIC=m
# 注：HDMI_LPE_AUDIO 依赖 DRM_I915，RT 内核下 i915 不可用，故本项无法启用，
#     已删除；RT 下 HDMI 音频走 HDA（SND_HDA_CODEC_HDMI）。
CONFIG_SND_ENS1371=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI=m
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=m
CONFIG_SND_SOC_INTEL_BYTCR_RT5651_MACH=m
CONFIG_SND_SOC_INTEL_CHT_BSW_RT5645_MACH=m
# WM5102 编解码（可选，Bay Trail 板罕见）；需 MFD_ARIZONA 与 SPI
CONFIG_SND_SOC_INTEL_BYTCR_WM5102_MACH=m
CONFIG_MFD_ARIZONA_I2C=m
CONFIG_MFD_WM5102=y
# Broadwell 音频（可选，J1900/J1800 用不到）
CONFIG_SND_SOC_INTEL_BROADWELL_MACH=m
CONFIG_SND_SOC_AC97_CODEC=m

# ---- 11. 额外有线网卡（模块化）----
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_VIA_RHINE=m
CONFIG_8139TOO=m
CONFIG_8139CP=m
CONFIG_NE2K_PCI=m
CONFIG_TULIP=m
CONFIG_DE2104X=m

# ---- 12. 无线网卡（模块化）----
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH5K=m
CONFIG_CARL9170=m
CONFIG_ATH10K=m
CONFIG_B43=m
CONFIG_B43LEGACY=m
CONFIG_BRCMFMAC=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800PCI=m
CONFIG_RTL8187=m
CONFIG_RTL8192CU=m
CONFIG_RTL8192CE=m
CONFIG_RTL8192SE=m
CONFIG_RTL8192DE=m
CONFIG_RTL8XXXU=m
CONFIG_MT76x2E=m
CONFIG_MT76x0U=m
# RTL8723BS（staging SDIO WiFi）需要 MMC 与 STAGING
CONFIG_STAGING=y
CONFIG_MMC=m
CONFIG_RTL8723BS=m

# ---- 13. 蓝牙（模块化；子特性为 bool，必须写 =y）----
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_ATH3K=y
CONFIG_BT_HCIUART_LL=y
CONFIG_BT_HCIBCM203X=m
CONFIG_BT_HCIBFUSB=m
CONFIG_BT_HCIVHCI=m
CONFIG_BT_MRVL=m
CONFIG_BT_MTKSDIO=m
CONFIG_CRYPTO_CMAC=m
# BT_HCIUART_BCM 需要 SERIAL_DEV_BUS 为 =y（SERIAL_DEV_CTRL_TTYPORT 依赖 !=m）
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# ---- 14. 额外文件系统（模块化）----
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m

# ---- 15. 网络加速 / 拥塞控制 ----
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=m
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# ---- 16. Netfilter / NAT（模块化；需 NF_TABLES 主开关）----
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_XFRM=m
CONFIG_NF_CONNTRACK=m
CONFIG_NETFILTER_XTABLES=m

# ---- 17. 其他工控机常用 ----
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- 18. CIFS/SMB File System（模块化）----
# 注：加密算法（CRYPTO_MD5/SHA256/SHA512/CMAC/HMAC/AES/ECB/CCM/GCM）
#     由 CONFIG_CIFS 自动 select，无需手写。
CONFIG_CIFS=m
CONFIG_CIFS_STATS2=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
