#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- RT 实时内核（模块化版）
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
#
# 用法：
#   make x86_64_defconfig
#   scripts/kconfig/merge_config.sh -m .config <本文件>
#   make olddefconfig          # 自动补全依赖、剔除非法项
#   make -j$(nproc) bzImage modules
#
# 模块策略（混合模式：关键驱动内建 + 其余模块化）：
#   =y（内建）：根文件系统、存储控制器、显示、USB 控制器、HID/键盘鼠标、
#               输入核心、控制台/TTY、板载主网卡
#        → 保证"即使模块没装全，也能启动、能打字、有显示、有网"
#   =m（模块）：声卡、无线网卡、蓝牙、额外有线网卡、额外文件系统、SoC 板级音频
#        → bzImage 更小、换硬件不必重编，装机后由 udev 自动加载
#
# 本文件已按 6.12.115 真实 Kconfig 逐项核对，三条硬规则：
#   ① 不写隐藏符号（无 prompt，写进去无效，由 select / default 决定）：
#      USB_COMMON、USB_XHCI_PCI、USB_EHCI_PCI、SND_HWDEP、
#      SND_SST_ATOM_HIFI2_PLATFORM、SND_AC97_CODEC、MT76_CORE、IRQ_FORCED_THREADING
#   ② bool 类型符号只能写 =y，不能写 =m：
#      SND_PCI（menuconfig）、SND_X86、BT_HCIBTUSB_BCM/RTL/MTK、
#      BT_HCIUART_BCM/RTL/ATH3K/LL、NF_TABLES_INET
#   ③ 6.12 不存在的符号一律删除：
#      CIFS_STATS、CIFS_ACL、CIFS_MD5、CIFS_SHA2、CIFS_HMAC_MD5、CIFS_HMAC_SHA256
#

# ---- 0. 模块支持 ----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt-mod"
# 建议保持关闭：否则在 git 仓库中构建会得到 6.12.115-rt-mod-g<hash>，
# 使 /lib/modules/<ver> 路径漂移，模块安装/引用失配。
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
# CONFIG_HZ 无独立 prompt，由 choice（HZ_1000）决定，无需单独设置
CONFIG_HIGH_RES_TIMERS=y

# ---- 2. 电源管理（RT 下用 Performance 调度，避免引入延迟）----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ============================================================
# ==========  A. 关键驱动 —— 内建（=y）  ======================
# ============================================================

# ---- 3. 显示（Bay Trail 核显 i915，内建，避免早期控制台黑屏）----
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- 4. USB 主机控制器（键鼠/U盘必需，内建）----
CONFIG_USB=y
CONFIG_USB_PCI=y
# USB 3.0（Bay Trail 主要 USB 口）
CONFIG_USB_XHCI_HCD=y
# USB 2.0
CONFIG_USB_EHCI_HCD=y
# USB 1.1
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
# 老式 UHCI 控制器
CONFIG_USB_UHCI_HCD=y
# U 盘 / 外接存储
CONFIG_USB_STORAGE=y

# ---- 5. SCSI（USB_STORAGE 的硬依赖，必须与之一致内建）----
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ---- 6. 输入核心 + HID（键盘鼠标必需，内建）----
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
# AT/PS2 键盘（所有键盘的基础驱动）
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
# PS/2 鼠标
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SENTELIC=y
CONFIG_MOUSE_PS2_TOUCHKIT=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_INPUT_MOUSEDEV=y
# 串行输入核心 + i8042（PS/2 键盘控制器；Bay Trail 上桥仍带此控制器）
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
# 通用 HID（USB 键盘的核心协议驱动）
CONFIG_HID=y
CONFIG_HID_GENERIC=y
# USB HID 传输层（没有它 USB 键盘完全不工作）
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_INPUT_EVDEV=y

# ---- 7. 控制台 / TTY（保证 tty 可输入、可回显）----
CONFIG_TTY=y
CONFIG_VT=y
# VT 控制台（必须，否则 tty 打字无反应）
CONFIG_VT_CONSOLE=y
# 控制台字符翻译（键盘输入的字符正确显示）
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- 8. 板载主网卡（RTL8111，内建保证一定有网）----
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y

# ---- 9. 基础文件系统（根 FS 与 EFI 分区必需，内建）----
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ============================================================
# ==========  B. 其余驱动 —— 模块化（=m）  ====================
# ============================================================

# ---- 10. 声卡（模块化；注意 bool 项只能 =y）----
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_PCI=y
CONFIG_SND_SEQUENCER=m
CONFIG_SND_X86=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_CA0132=m
CONFIG_SND_HDA_CODEC_SI3054=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_HDMI_LPE_AUDIO=m
CONFIG_SND_ENS1371=m
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI=m
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=m
CONFIG_SND_SOC_INTEL_BYTCR_RT5651_MACH=m
CONFIG_SND_SOC_INTEL_BYTCR_WM5102_MACH=m
CONFIG_SND_SOC_INTEL_CHT_BSW_RT5645_MACH=m
CONFIG_SND_SOC_INTEL_BROADWELL_MACH=m
CONFIG_SND_SOC_AC97_CODEC=m

# ---- 11. 额外有线网卡（模块化）----
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_VIA_RHINE=m
CONFIG_8139TOO=m
CONFIG_8139CP=m
CONFIG_NE2K_PCI=m
CONFIG_TULIP=m
CONFIG_DE2104X=m

# ---- 12. 无线网卡（模块化）----
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH5K=m
CONFIG_CARL9170=m
CONFIG_ATH10K=m
CONFIG_B43=m
CONFIG_B43LEGACY=m
CONFIG_BRCMFMAC=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800PCI=m
CONFIG_RTL8187=m
CONFIG_RTL8192CU=m
CONFIG_RTL8192CE=m
CONFIG_RTL8192SE=m
CONFIG_RTL8192DE=m
CONFIG_RTL8723BS=m
CONFIG_RTL8XXXU=m
CONFIG_MT76x2E=m
CONFIG_MT76x0U=m

# ---- 13. 蓝牙（模块化；子选项多为 bool，只能 =y）----
CONFIG_BT=m
CONFIG_BT_RFCOMM=m
CONFIG_BT_HIDP=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_ATH3K=y
CONFIG_BT_HCIUART_LL=y
CONFIG_BT_HCIBCM203X=m
CONFIG_BT_HCIBFUSB=m
CONFIG_BT_HCIVHCI=m
CONFIG_BT_MRVL=m
CONFIG_BT_MTKSDIO=m
CONFIG_CRYPTO_CMAC=m

# ---- 14. 额外文件系统（模块化）----
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m

# ---- 15. 网络加速 / 拥塞控制 ----
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=m
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_TCP_CONG 无独立 prompt，由 CONFIG_DEFAULT_BBR 自动得出（bbr）

# ---- 16. Netfilter / NAT（模块化；NF_TABLES_INET 是 bool，只能 =y）----
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_CT=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_XFRM=m
CONFIG_NETFILTER_XTABLES=m

# ---- 17. 其他工控机常用 ----
CONFIG_HPET_TIMER=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- 18. CIFS/SMB File System Support（模块化）----
# 只保留 6.12.115 真实存在的符号；旧的 CIFS_STATS / CIFS_ACL /
# CIFS_MD5 / CIFS_SHA2 / CIFS_HMAC_MD5 / CIFS_HMAC_SHA256 均已删除。
CONFIG_CIFS=m
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
CONFIG_CIFS_UPCALL=y
CONFIG_CIFS_DFS_UPCALL=y
# 说明：CIFS 的 Kconfig 会自动 select 一整套加密依赖
#   （CRYPTO_MD5 / SHA256 / SHA512 / CMAC / HMAC / AES / ECB / GCM / CCM / AEAD2），
# 无需手工添加；手工写反而容易因符号名记错而失效。
# 需要更详尽的 SMB 统计信息时，可另开 CONFIG_CIFS_STATS2=y（default y）。
