#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- RT 实时内核（模块化版）
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
#
# 用法：先 make x86_64_defconfig，再用 merge_config.sh 叠加本文件。
#       只写"需要在 defconfig 基础上额外开启或修改"的选项。
#       6.12 起 PREEMPT_RT 已并入主线，无需打补丁。
#
# 模块策略（本文件 = 混合模式：关键驱动内建 + 其余模块化）：
#   =y（内建）：根文件系统、存储控制器、显示、USB 控制器、HID/键盘鼠标、
#               控制台、板载主网卡
#        → 保证"即使模块没装全，也能启动、能打字、有显示、有网"
#   =m（模块）：声卡、无线网卡、蓝牙、额外有线网卡、额外文件系统、SoC 板级音频
#        → bzImage 更小、换硬件不必重编，装机后由 udev 自动加载
#
#   本模式会生成 /lib/modules/6.12.115-rt/*.ko（十几~几十 MB），
#   安装时必须把 modules.tar.gz 一并解压到目标盘 /lib/modules/。
#   （build-img-mbr.yml / build-img-gpt.yml 的 Populate rootfs 步骤已自动处理）
#
#   注意：固件（firmware）不会编进内核，仍要靠 rootfs 里的 /lib/firmware
#         （firmware-realtek / firmware-iwlwifi / firmware-linux 等）。
#

# ---- 0. 模块支持（模块化必需）----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt"
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IRQ_FORCED_THREADING=y

# 注：CONFIG_PREEMPT 在 defconfig 里是 =y（x86 默认），不必重复。
#     CONFIG_PREEMPT_DYNAMIC 与 PREEMPT_RT 互斥，不写。

# ---- 2. 电源管理（RT 下用 Performance 调度，避免引入延迟）----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ============================================================
# ==========  A. 关键驱动 —— 内建（=y）  ======================
# ============================================================

# ---- 3. 显示（Bay Trail 核显 i915，内建，避免早期控制台黑屏）----
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- 4. USB 主机控制器（键鼠/U盘必需，内建）----
CONFIG_USB=y
CONFIG_USB_COMMON=y
CONFIG_USB_PCI=y
# USB 3.0（Bay Trail 主要 USB 口）
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
# USB 2.0
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
# USB 1.1
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
# 老式 UHCI 控制器
CONFIG_USB_UHCI_HCD=y

# ---- 5. 输入设备核心 + HID（键盘鼠标必需，内建）----
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
# AT/PS2 键盘（所有键盘的基础驱动）
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
# PS/2 鼠标
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SENTELIC=y
CONFIG_MOUSE_PS2_TOUCHKIT=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID=y
# 通用 HID（USB 键盘的核心协议驱动）
CONFIG_HID_GENERIC=y
# USB HID 传输层（没有它 USB 键盘完全不工作）
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_INPUT_EVDEV=y
CONFIG_USB_STORAGE=y

# ---- 6. 控制台 / TTY（保证 tty 可输入）----
CONFIG_TTY=y
CONFIG_VT=y
# VT 控制台（必须，否则 tty 打字无反应）
CONFIG_VT_CONSOLE=y
# CONFIG_HW_CONSOLE: 6.12 已无此符号，删除（VT=y 时控制台自动可用）
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- 7. 板载主网卡（RTL8111，内建保证一定有网）----
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y

# ---- 8. 文件系统（根 FS 与 EFI 分区必需，内建）----
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ============================================================
# ==========  B. 其余驱动 —— 模块化（=m）  ====================
# ============================================================

# ---- 9. 声卡（模块化）----
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_PCI=m
CONFIG_SND_HWDEP=m
CONFIG_SND_SEQUENCER=m
