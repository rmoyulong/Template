#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- RT 实时内核（模块化版）
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
# 实际硬件：RTL8111 有线网卡 + Intel 6205 无线网卡（其余网卡、蓝牙本机都不存在）
#
# 用法：先 make x86_64_defconfig，再用 merge_config.sh 叠加本文件，
#       最后 make olddefconfig 补全依赖。
#       6.12 起 PREEMPT_RT 已并入主线，无需打补丁。
#
# 模块策略（混合模式：关键驱动内建 + 其余模块化）：
#   =y：根文件系统、显示、USB 控制器/存储、HID/键盘鼠标、控制台、板载主网卡、
#       Bay Trail 平台基础（I2C/GPIO/LPSS/SPI）、MMC
#   =m：声卡、Intel 无线网卡、CIFS、Netfilter/NAT（按需加载，不占开机时间）
#
# 本文件已按 6.12.115 真实 Kconfig 逐符号校验：
# - 删除不存在符号：CONFIG_CIFS_STATS / CONFIG_CIFS_ACL /
#   CONFIG_CIFS_MD5 / CONFIG_CIFS_SHA2 / CONFIG_CIFS_HMAC_MD5 /
#   CONFIG_CIFS_HMAC_SHA256
# - 修正 bool 误写为 =m 的符号（SND_PCI / SND_X86 / NF_TABLES_INET 等）
# - 排除隐藏符号（无 prompt，写了也会被 olddefconfig 丢弃）：
#   IRQ_FORCED_THREADING / USB_COMMON / USB_XHCI_PCI / USB_EHCI_PCI /
#   SND_HWDEP / SND_SST_ATOM_HIFI2_PLATFORM / SND_AC97_CODEC / MT76_CORE
#
# 【本版重要变更 —— 瘦身提速】
#   上一版把 20 多种无线网卡、10 种有线网卡、整条蓝牙栈、XFS/BTRFS 等都编成
#   了模块，modules.tar.gz 因此很大。而 initramfs 用 MODULES=most 时会把
#   /lib/modules 下的模块**全部**打进 initramfs，开机最早期要整体解压 ——
#   这才是"同一台机器启动很慢"的主因。
#   本版把本机用不到的驱动直接关掉（不再编成模块），modules 包和 initramfs
#   同时瘦下来。裁剪原则：只关本机没有的硬件，启动链路一律不动。
#
# 保留的重要特性：
# - 显示：FB + FB_VESA + DRM_SIMPLEDRM + SYSFB_SIMPLEFB，MBR/传统 BIOS 与
#   UEFI 两条路都有帧缓冲，Plymouth 开机画面可显示（RT 下 i915 不可用）。
# - 拥塞控制：CONFIG_DEFAULT_BBR=y，否则 olddefconfig 会按 choice 退回 cubic。
# - 内核压缩：zstd（解压速度约为 gzip 的 2~3 倍；构建机需装 zstd）。
#
# 版本号差异说明：本版 LOCALVERSION="-rt-mod"，uname -r = 6.12.115-rt-mod，
#   与全内建版（6.12.115-rt）分开，避免两者 /lib/modules/<ver> 互相覆盖。
#   装机时必须把 modules.tar.gz（含真实 .ko）解压到 /lib/modules/6.12.115-rt-mod/。
#

# ---- 0. 模块支持 ----
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt-mod"
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y

# ---- 1b. 内核镜像压缩算法（方案一：zstd，解压最快）----
# 6.12 的内核压缩算法是 choice 组，默认 KERNEL_GZIP；必须显式关掉 GZIP，
# 否则 merge_config 后会同时出现两个 choice 成员，olddefconfig 会退回默认 gzip。
# 注意：KERNEL_ZSTD 需要构建机具备 zstd 命令（build-kernel.yml 已加入）。
# CONFIG_KERNEL_GZIP is not set
CONFIG_KERNEL_ZSTD=y

# ---- 2. 电源管理（RT 下用 Performance，避免引入延迟）----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ============================================================
# ========== A. 关键驱动 —— 内建（=y） ======================
# ============================================================

# ---- 3. 显示 ----
# 重要：6.12 中 DRM_I915 带 "depends on !PREEMPT_RT"，RT 内核下必然为 n，
# 写 CONFIG_DRM_I915=y 会被 olddefconfig 丢弃。RT 下改用 simpledrm
# 提供控制台显示；如需 i915 必须改用非 RT 内核。
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# 传统 BIOS（GRUB 用 VBE 设置的帧缓冲）兜底：SYSFB_SIMPLEFB 能接管时走
# simpledrm，接管不了时由 vesafb 顶上；两个都没有的话，MBR/传统 BIOS 启动
# 就没有帧缓冲，Plymouth 无法显示。
CONFIG_FB=y
CONFIG_FB_VESA=y

# ---- 4. USB 主机控制器（键鼠/U盘必需，内建）----
# 说明：USB_COMMON、USB_XHCI_PCI、USB_EHCI_PCI、USB_OHCI_HCD_PCI 为隐藏项，
# 由下面这些可见项自动选中，无需（也不能）手写。
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
# U 盘/外接存储（依赖 SCSI 与 BLK_DEV_SD）
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# ---- 5. 输入设备核心 + HID（键盘鼠标必需，内建）----
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=y
CONFIG_MOUSE_PS2_LOGIPS2PP=y
CONFIG_MOUSE_PS2_SYNAPTICS=y
CONFIG_MOUSE_PS2_CYPRESS=y
CONFIG_MOUSE_PS2_TRACKPOINT=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_SENTELIC=y
CONFIG_MOUSE_PS2_TOUCHKIT=y
CONFIG_MOUSE_PS2_FOCALTECH=y
CONFIG_MOUSE_PS2_VMMOUSE=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y

# ---- 6. 控制台 / TTY ----
# 说明：SERIO / SERIO_I8042 / SERIO_LIBPS2 由 KEYBOARD_ATKBD 自动 select。
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- 7. 板载主网卡（RTL8111，内建保证一定有网）----
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y

# ---- 8. 文件系统（根 FS 与 EFI 分区必需，内建）----
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# ---- 9. Bay Trail 平台基础（SoC 音频/外设的内建依赖）----
CONFIG_I2C=y
# 说明：CONFIG_I2C_DESIGNWARE_PLATFORM 在你两次真实构建产出的 .config 里
#   都不存在 —— 它的依赖 (ACPI && COMMON_CLK) 在当前配置下未满足，写了不会生效。
#   即 Bay Trail 的 DesignWare I2C 控制器驱动在当前配置下无法启用。
# CONFIG_I2C_DESIGNWARE_PLATFORM is not set
CONFIG_X86_INTEL_LPSS=y
CONFIG_GPIOLIB=y
# 注：SPI_MASTER 是隐藏项（default SPI），应写 CONFIG_SPI=y
CONFIG_SPI=y
# I2C_DESIGNWARE_PLATFORM 在 x86 上需要 COMMON_CLK
CONFIG_COMMON_CLK=y

# ---- 10. SD 卡（部分工控板带 SD 槽；用不到可关）----
CONFIG_MMC=m

# ============================================================
# ========== B. 其余驱动 —— 模块化（=m） ====================
# ============================================================
# 这些不是开机必需，装成模块后平时躺在 /lib/modules 里，谁用谁加载，
# 不占 bzImage、也不占开机时间。

# ---- 11. 声卡（模块化；本机走 HDA + Realtek）----
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_PCI=y
CONFIG_SND_X86=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0
# Bay Trail / Cherry Trail 板级音频（SoC 侧，作为 HDA 之外的补充）
# 注：HDMI_LPE_AUDIO 依赖 DRM_I915，RT 内核下 i915 不可用，故无法启用；
#     RT 下 HDMI 音频走 HDA（SND_HDA_CODEC_HDMI）。
CONFIG_SND_SOC=m
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI=m
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=m
CONFIG_SND_SOC_INTEL_BYTCR_RT5651_MACH=m
CONFIG_SND_SOC_INTEL_CHT_BSW_RT5645_MACH=m

# ---- 12. 无线网卡（模块化；本机只有 Intel 6205）----
# 装成模块的好处：内核启动早期不会去加载固件，也就不会出现
# "找不到固件 → dump 满屏寄存器 → 冲掉 Plymouth 画面"的问题。
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m

# ---- 13. 网络加速 / 拥塞控制 ----
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_SCH_CAKE=m
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=m
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_TCP_CONG_BBR=y
# 必须同时选 DEFAULT_BBR=y：DEFAULT_TCP_CONG 是由 choice 推导的字符串，
# 只写 CONFIG_DEFAULT_TCP_CONG="bbr" 会被 olddefconfig 重新推导回 cubic。
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# ---- 14. Netfilter / NAT（模块化；需 NF_TABLES 主开关）----
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_XFRM=m
CONFIG_NF_CONNTRACK=m
CONFIG_NETFILTER_XTABLES=m

# ---- 15. 其他工控机常用 ----
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- 16. CIFS/SMB File System（模块化）----
# 注：加密算法（CRYPTO_MD5/SHA256/SHA512/CMAC/HMAC/AES/ECB/CCM/GCM）
# 由 CONFIG_CIFS 自动 select，无需手写。
CONFIG_CIFS=m
CONFIG_CIFS_STATS2=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y

# ============================================================
# ========== C. 精简：关闭本机用不到的子系统 ==================
# ============================================================
# 为什么放在最后：merge_config.sh 按顺序合并，后面的行覆盖前面的，
#   所以"关闭"一律写在这里，保证能压过前面任何 =y / =m 的写法。
#
# 判定依据：已用 build-kernel 产出的最终 .config（config-rt-mod.txt）逐符号核对，
#   下面每一项在该配置里当前都是 =y 或 =m（即真实占用空间/模块包体积），
#   确认后才关。对模块化内核来说，关掉它们能让 modules.tar.gz 和 initramfs
#   一起变小 —— 这是"开机变快"的关键。
#
# ★ 安全边界：以下内容完全不涉及启动链路 —— SATA/AHCI、USB 控制器与存储、
#   HID/键盘、VT 控制台、显示帧缓冲、RTL8111 网卡、Intel 无线、ext4/vfat
#   全部原样保留。若某项未列在这里，就是刻意保留的。

# ---- C1. 虚拟化 / 云主机支持（物理机完全用不到）----
# HYPERVISOR_GUEST 关掉后，KVM_GUEST / PARAVIRT 等会随之自动关闭。
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set

# ---- C2. 无关有线网卡（本机只有 RTL8111，见上面第 7 节）----
# CONFIG_E1000 is not set
# CONFIG_E1000E is not set
# CONFIG_IGB is not set
# CONFIG_IGC is not set
# CONFIG_8139TOO is not set
# CONFIG_8139CP is not set
# CONFIG_NE2K_PCI is not set
# CONFIG_TULIP is not set
# CONFIG_DE2104X is not set
# CONFIG_VIA_RHINE is not set

# ---- C3. 无关无线网卡（本机只有 Intel 6205，见上面第 12 节）----
# 关掉厂商总开关即可连带关掉其下所有驱动（ATH* / B43* / RT2X00 /
# RTL8187 / RTL8192* / RTL8XXXU / RTL8723BS / MT76* 等）。
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_BROADCOM is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set
#
# 想恢复某家的网卡（例如换成 Atheros 网卡），把对应那行整行删掉即可。

# ---- C4. 蓝牙（本机无蓝牙）----
# 关掉主开关，整条蓝牙栈（USB/UART/SDIO 三路）全部不编。
# CONFIG_BT is not set

# ---- C5. 调试 / 追踪（生产机不需要，与功能无关）----
# KALLSYMS_ALL 是收益最大的一项：它把内核里所有符号（含局部符号）都存进
# bzImage 的符号表里，纯属排障用。
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_BLK_DEV_IO_TRACE is not set

# ---- C6. 冗余文件系统（根用 ext4，EFI 用 vfat，已经够了）----
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_9P_FS is not set
# 下面两项按需保留（默认关闭）。若以后要挂 ISO 镜像 / 挂 NFS 共享，
# 把对应那行整行删掉（或改成 CONFIG_XXX=y）即可启用。
# CONFIG_ISO9660_FS is not set
# CONFIG_NFS_FS is not set

# ---- C7. 冗余块设备 / SCSI / 老式 PATA ----
# 注：BLK_DEV_MD（软 RAID）与 BLK_DEV_DM（LVM / dm-crypt）刻意保留，
#     因为装系统或做加密盘时可能会用到，体积也不大。
# CONFIG_BLK_DEV_SR is not set
# CONFIG_SCSI_CONSTANTS is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_PATA_AMD is not set
# CONFIG_PATA_OLDPIIX is not set
# CONFIG_PATA_SCH is not set

# ---- C8. HID 厂商专用 quirk（通用 HID 已覆盖绝大多数键鼠）----
# 说明：这些是给特定品牌外设做的特性补丁（多媒体键、背光等）。
#   关掉后普通键盘鼠标照常工作（走 HID_GENERIC），只是个别品牌的高级按键失效。
#   若你用的正是某个品牌键鼠且需要它的特殊按键，把对应那行整行删掉即可。
# CONFIG_HID_A4TECH is not set
# CONFIG_HID_APPLE is not set
# CONFIG_HID_BELKIN is not set
# CONFIG_HID_CHERRY is not set
# CONFIG_HID_CHICONY is not set
# CONFIG_HID_CYPRESS is not set
# CONFIG_HID_EZKEY is not set
# CONFIG_HID_GYRATION is not set
# CONFIG_HID_ITE is not set
# CONFIG_HID_KENSINGTON is not set
# CONFIG_HID_LOGITECH is not set
# CONFIG_HID_MICROSOFT is not set
# CONFIG_HID_MONTEREY is not set
# CONFIG_HID_NTRIG is not set
# CONFIG_HID_PANTHERLORD is not set
# CONFIG_HID_PETALYNX is not set
# CONFIG_HID_PID is not set
# CONFIG_HID_REDRAGON is not set
# CONFIG_HID_SAMSUNG is not set
# CONFIG_HID_SONY is not set
# CONFIG_HID_SUNPLUS is not set

# ---- C9. 冗余音频（本机走 HDA + Realtek，见上面第 11 节）----
# CONFIG_SND_ENS1371 is not set
# CONFIG_SND_USB_AUDIO is not set
# CONFIG_SND_HDA_CODEC_CA0132 is not set
# CONFIG_SND_HDA_CODEC_SI3054 is not set

# ---- C10. 其他 ----
# SELinux：Debian 不用它（默认走 AppArmor），关掉省一份安全钩子开销。
# CONFIG_SECURITY_SELINUX is not set
# IP_PNP：网络启动（root-over-NFS）才需要，本机是本地盘启动。
