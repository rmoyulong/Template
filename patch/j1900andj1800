#
# Linux/x86 6.12.115 Kernel Configuration Fragment --- 普通内核（非 RT）
# 目标平台：Intel Bay Trail（J1800 / J1900 / N3540），x86_64
#
# 与 RT 版的差异只有 3 处：
#   - LOCALVERSION 为空（编出来是 6.12.115，不带 -rt 后缀）
#   - 不开 CONFIG_PREEMPT_RT
#   - 开启 CONFIG_PREEMPT_DYNAMIC（可用 preempt=full/voluntary/none 运行时切换）
#

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION=""
CONFIG_EXPERT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_HIGH_RES_TIMERS=y

# ---- 2. 电源管理 ----
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_INTEL_IDLE=y

# ---- 3. 显示（Bay Trail 核显 i915）----
CONFIG_DRM_I915=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---- 4. 声卡（核心！缺这条 /proc/asound 都不会出现）----
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CA0132=y
CONFIG_SND_HDA_CODEC_SI3054=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_RECONFIG=y
CONFIG_SND_HDA_INPUT_BEEP=y
CONFIG_SND_HDA_POWER_SAVE_DEFAULT=0
CONFIG_SND_X86=y
CONFIG_HDMI_LPE_AUDIO=y
CONFIG_SND_ENS1371=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_HWDEP=y
CONFIG_SND_SEQUENCER=y

CONFIG_SND_SOC=y
CONFIG_SND_SOC_INTEL_SST_TOPLEVEL=y
CONFIG_SND_SST_ATOM_HIFI2_PLATFORM_ACPI=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5640_MACH=y
CONFIG_SND_SOC_INTEL_BYTCR_RT5651_MACH=y
