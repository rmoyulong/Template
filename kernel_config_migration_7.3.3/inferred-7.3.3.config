# Linux 7.3.3 migration seed for Daphile
# Target: x86_64 + PREEMPT_RT
# Derived from the evidence-backed fragment inferred from Linux 6.12.30-daphile.
# THIS IS A CONFIG FRAGMENT, NOT A COMPLETE .config.
# Run apply_migration.sh against an unmodified Linux 7.3.3 source tree.
#
# Architecture selection is intentionally created from x86_64_defconfig by the script.
# Unknown old settings are not forced to 'n'.

# ---- 0. 模块支持 ----
# General kernel/module capabilities evidenced by the old rootfs
CONFIG_SMP=y
CONFIG_MODULE_UNLOAD=y

# ---- 1. 本地版本与抢占模型 ----
CONFIG_LOCALVERSION="-rt-mod"
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y

# ---- 1b. 内核镜像压缩算法（方案一：zstd，解压最快）----
# 7.3 的内核压缩算法是 choice 组，默认 KERNEL_GZIP；必须显式关掉 GZIP，
# 否则 merge_config 后会同时出现两个 choice 成员，olddefconfig 会退回默认 gzip。
# 注意：KERNEL_ZSTD 需要构建机具备 zstd 命令（build-kernel.yml 已加入）。
# CONFIG_KERNEL_GZIP is not set
CONFIG_KERNEL_ZSTD=y

# Audio core (built-in evidence in the old rootfs)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_ALOOP=y
CONFIG_SND_USB_AUDIO=y

# Filesystems evidenced as built-in in the old rootfs
CONFIG_AUTOFS_FS=y
CONFIG_CIFS=y
CONFIG_EFIVAR_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_FUSE_FS=y
CONFIG_HFSPLUS_FS=y
CONFIG_HFS_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JBD2=y
CONFIG_MSDOS_FS=y
CONFIG_NFS_FS=y
CONFIG_NTFS3_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_UDF_FS=y
CONFIG_VFAT_FS=y

# Networking / bridge / netfilter evidenced as built-in
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_IPV6=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_PACKET=y
