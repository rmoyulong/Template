# Daphile official 6.12.30 reconstruction - confirmed fragment v2
# This is NOT a complete .config. It contains only settings supported by
# the official 6.12.30-daphile kernel/modules artifacts and Linux v6.12.30
# Kconfig/Makefile dependencies. Merge into a clean x86_64 base, then run
# olddefconfig and inspect the resulting values.

# Architecture / core prerequisites
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_PCI=y
CONFIG_INPUT=y

# RT and loadable modules (official vermagic: SMP preempt_rt mod_unload)
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# ALSA core and loopback (all present in official modules.builtin)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_ALOOP=y
CONFIG_SND_PCI=y
CONFIG_HIGH_RES_TIMERS=y

# HDA stack (each matching .ko.xz exists in official module package)
CONFIG_SND_HDA=m
CONFIG_SND_HDA_CORE=m
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_INTEL_DSP_CONFIG=m
